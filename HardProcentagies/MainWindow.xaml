<Window x:Class="HardProcentagies.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HardProcentagies"
        mc:Ignorable="d"
        Title="Hard Percentages" Height="450" Width="800">
    <Grid>
        <TextBox x:Name="Money" HorizontalAlignment="Left" Margin="134,142,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" TextChanged="Money_TextChanged"/>
        <TextBox x:Name="Rate" HorizontalAlignment="Left" Margin="134,319,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" TextChanged="Rate_TextChanged"/>
        <TextBox x:Name="PeriodMonths" HorizontalAlignment="Left" Margin="134,230,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" TextChanged="Period_TextChanged"/>
        <Label x:Name="PercentIncome" Content="" HorizontalAlignment="Left" Margin="570,281,0,0" VerticalAlignment="Top" RenderTransformOrigin="0,1.151"/>
        <Label x:Name="MoneyIncome" Content="" HorizontalAlignment="Left" Margin="570,350,0,0" VerticalAlignment="Top"/>
        <Button x:Name="Computing" Content="Button" HorizontalAlignment="Left" Margin="520,102,0,0" VerticalAlignment="Top" Click="Computing_Click" Height="59" Width="139"/>
        <Label Content="How much money will you add to account" HorizontalAlignment="Left" Margin="77,111,0,0" VerticalAlignment="Top"/>
        <Label Content="Period" HorizontalAlignment="Left" Margin="177,0,0,0" VerticalAlignment="Center"/>
        <Label Content="Deposit rate" HorizontalAlignment="Left" Margin="157,281,0,0" VerticalAlignment="Top"/>
        <Label x:Name="TotalAmount" Content="" HorizontalAlignment="Left" Margin="570,217,0,0" VerticalAlignment="Top"/>
        <Label Content="Percent income" HorizontalAlignment="Left" Margin="542,250,0,0" VerticalAlignment="Top"/>
        <Label Content="Money income" HorizontalAlignment="Left" Margin="545,319,0,0" VerticalAlignment="Top"/>
        <Label Content="Total amount" HorizontalAlignment="Left" Margin="550,191,0,0" VerticalAlignment="Top"/>
        <Label Content="Compound interest calculator" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" FontSize="36"/>

    </Grid>
</Window>
